{
  "name": "resenha",
  "version": "2.0.0",
  "description": "Salas de voz, chat e transmissão de tela estilo Discord (LiveKit + Supabase)",
  "main": "server.js",
  "scripts": {
    "build": "esbuild src/main.js --bundle --splitting --minify --sourcemap --format=esm --target=es2020 --outdir=public/dist --entry-names=app --chunk-names=chunk-[hash]",
    "test": "node --test",
    "postinstall": "npm run build",
    "start": "node server.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "18.0.10",
    "esbuild": "^0.28.2",
    "express": "^4.19.2",
    "livekit-client": "^2.23.0",
    "livekit-server-sdk": "^2.19.2",
    "stripe": "23.2.0"
  },
  "devDependencies": {
    "fake-indexeddb": "6.2.8"
  }
}
